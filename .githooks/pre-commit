#!/usr/bin/env bash
# 1. Strips metadata (EXIF, GPS, camera info, text chunks) from images before they are committed.
# 2. Lowercases the `tags:` line in the front matter of staged article markdown files.

staged() { git diff --cached --name-only --diff-filter=ACM -z; }

while IFS= read -r -d '' f; do
  case "${f,,}" in
    *.jpg|*.jpeg|*.png|*.webp|*.tif|*.tiff)
      command -v mogrify >/dev/null 2>&1 || { echo "pre-commit: ImageMagick (mogrify) not found, cannot strip image metadata" >&2; exit 1; }
      # auto-orient first so photos don't turn sideways once the orientation tag is gone
      mogrify -auto-orient -strip "$f" && git add -- "$f"
      echo "pre-commit: stripped metadata from $f"
      ;;
    articles/*.md)
      # only touch the `tags:` line between the first two `---` lines
      before=$(cksum < "$f")
      perl -i -pe '$n++ if /^---\r?$/; $_ = lc if $n == 1 && /^tags:/' "$f"
      if [ "$before" != "$(cksum < "$f")" ]; then
        git add -- "$f"
        echo "pre-commit: lowercased tags in $f"
      fi
      ;;
  esac
done < <(staged)
